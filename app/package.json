{
  "name": "ecompany-desktop-dev",
  "version": "2.0.0",
  "description": "eCompany · AI 虚拟公司 v2.0 桌面应用 — 全AI团队协作管理",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "pack": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.ecompany.desktop.v2",
    "productName": "ECompany Asst",
    "directories": {
      "output": "../dist-desktop-v2"
    },
    "electronDist": "./node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "detect-lang.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../release/backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/node_modules/**/*.md",
          "!**/node_modules/**/test/**",
          "!**/node_modules/**/tests/**",
          "!**/node_modules/**/docs/**"
        ]
      },
      {
        "from": "../release/frontend",
        "to": "frontend"
      },
      {
        "from": "../release/node.exe",
        "to": "node.exe"
      },
      {
        "from": "../release/favicon.ico",
        "to": "favicon.ico"
      },
      {
        "from": "../release/logo.jpg",
        "to": "logo.jpg"
      },
      {
        "from": "../release/AI团队",
        "to": "AI团队"
      },
      {
        "from": "../release/启动eCompany.bat",
        "to": "启动eCompany.bat"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../release/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ECompany Asst",
      "uninstallDisplayName": "ECompany Asst v2.0 · AI 企业桌面助手"
    }
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0"
  }
}
